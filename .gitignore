instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebooks
.ipynb_checkpoints

# IPython
.ipython/

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, you might want to ignore it.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case you do not want to use requirements.txt, remove the comment from the next line.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#pdm.lock

# venv / Virtual Environments (Crucial to ignore)
env/
venv/
ENV/
env.bak/
venv.bak/
.env
.venv

# Development environment & Editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

debug.log
debug*.log
debug_*.log
